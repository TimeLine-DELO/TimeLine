{
	"name": "timeline-bookmarks",
	"version": "0.1.0",
	"private": true,
	"description": "A bookmark showcase you own: your X bookmarks, your lists, a static site.",
	"keywords": ["astro", "bookmarks", "cdp", "tailwindcss"],
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Timeline contributors"
	},
	"scripts": {
		"Build": "pnpm --filter @timeline/maintain run Build",
		"Run": "astro dev --host",
		"build": "astro build",
		"Format": "prettier --write .",
		"Format:Check": "prettier --check .",
		"maintain": "node Maintain/Target/Index.js",
		"RFC:Board": "python3 Documentation/Skill/RFC-Board/Reference/rfc_board.py plan",
		"RFC:Board:Sync": "python3 Documentation/Skill/RFC-Board/Reference/rfc_board.py sync",
		"RFC:Board:Verify": "python3 Documentation/Skill/RFC-Board/Reference/rfc_board.py verify",
		"Deploy:Rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
		"Emulators": "firebase emulators:start",
		"prepublishOnly": "pnpm run build",
		"tool": "pnpm --filter @timeline/maintain run tool"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/solid-js": "7.1.2",
		"@playform/build": "0.3.5",
		"@playform/compress": "0.2.5",
		"@playform/inline": "0.1.4",
		"@tailwindcss/aspect-ratio": "0.4.2",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"astro": "7.4.7",
		"astro-capo": "0.0.1",
		"astrojs-service-worker": "2.0.3",
		"autoprefixer": "10.6.2",
		"cssnano": "9.9.0",
		"cssnano-preset-advanced": "10.0.0",
		"dotenv": "18.0.9",
		"firebase": "13.1.0",
		"postcss": "8.5.32",
		"postcss-combine-duplicated-selectors": "11.0.0",
		"postcss-combine-media-query": "2.1.0",
		"postcss-import": "17.0.1",
		"postcss-reporter": "7.1.0",
		"postcss-url": "10.1.4",
		"solid-js": "1.9.18",
		"tailwindcss": "3.4.19",
		"typescript": "7.0.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "1.10.12",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"firebase-tools": "15.34.2",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"sass": "1.107.1",
		"turbo": "2.11.10",
		"vite": "8.3.5",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"publishConfig": {
		"access": "restricted",
		"provenance": true
	}
}
